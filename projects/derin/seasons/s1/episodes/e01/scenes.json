      "end": "fade_to_black",
      "lines": [
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yeşil sadece Nur Ana'nın masallarında olur."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "O zaman masal elimde duruyor."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "At onu. Şimdi. Kuyuya geri at.",
          "delivery": "panikle"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Neden?"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Çünkü bir yaprak bulduğunu duyarlarsa, ilk soracakları şey nereden geldiği olur."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Ben de onu soruyorum."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Sen sorma! Sen sorarsan seni de annen gibi…",
          "delivery": "kendini tutamadan"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Söyle. Annem gibi ne?",
          "delivery": "buz gibi"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Özür dilerim. Öyle demek istemedim."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Ama dedin."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ada, bak. Kural belli. Yukarıdan bir şey gelmez, çünkü yukarıda bir şey yok. Kül var."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Külden yaprak çıkmaz."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "O zaman Divan'a götürelim. Onlar açıklar."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Onlar açıklamaz. Onlar saklar."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Emre'nin ilacı onlarda, Ada.",
          "delivery": "yalvararak"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Biliyorum.",
          "delivery": "yumuşayarak"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Bu yaprak yüzünden ilaç gelmezse…"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kimse bilmeyecek. Sen ve ben."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ve kuyu."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kuyu konuşmaz."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Burada her şey konuşur. Duvarlar bile Divan'a çalışır."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "O zaman sessiz ol.",
          "delivery": "yaprağı bakır bileziğinin altına sıkıştırır"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Nur Ana'ya göstereceğim. O, yeşili görmüş birini tanır."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Nur Ana göremiyor ki."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Ama hatırlıyor."
        }
      ]
    },
