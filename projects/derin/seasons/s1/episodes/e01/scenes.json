      "lines": [
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Feneri yaklaştır. Suyun üstünde bir şey var."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Bir şey değil."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ne o zaman?"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Yaprak.",
          "voice_preset": "whisper"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ne?"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Yeşil bir yaprak, Kerem. Canlı.",
          "delivery": "büyülenmiş"
        }
      ],
      "sfx": [
        {
          "at_s": 0.8,
