      "lines": [
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ada… Ada! Biliyorum orada olduğunu. Nefesini duyuyorum.",
          "delivery": "havalandırma borusunun içinden, alaycı fısıltı"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Herkesin nefesini duyuyorsun, Kerem. Havalandırma senin.",
          "delivery": "karanlıkta, yorgun"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ama seninki farklı. Seninki hep sinirli.",
          "delivery": "keyifli"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kibriti düşürdüm. Konuşmayı kes de aşağı gel.",
          "delivery": "yerde el yordamıyla arıyor"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Karanlıkta kibrit arayan su bekçisi. Bunu Divan'a şikâyet etsem mi?",
          "delivery": "gülerek"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Et. Bu hafta payımız zaten yarım.",
          "delivery": "fener yanınca yüzü aydınlanır, kuru"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yarım mı? Kim dedi?",
          "delivery": "şakası bir anda kaybolur"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Koridorda herkes söylüyor. Rüzgâr kötüymüş."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Rüzgâr. Doksan yıldır görmediğimiz rüzgâr, hep kötü.",
          "delivery": "acı bir gülüşle"
        }
      ],
