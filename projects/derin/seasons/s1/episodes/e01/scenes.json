      "lines": [
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ada! Dur! Bekle!",
          "delivery": "koşarak, nefes nefese"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Ne oldu?"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Saim. Saim aşağı iniyor. Kendisi. Lambasıyla."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Saim on ikinci kata inmez."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Biliyorum! O yüzden koşuyorum!"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Nereye gidiyor?"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Kuyu odasına. Seni sormuş."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Yaman söylemiştir. Bileziği gördü."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yaprak nerede?"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Bileziğin altında."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Harika. Tam saklanacak yer. Gözünün önünde."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Sen eve git, Kerem."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Seni onunla yalnız bırakmam."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Emre'yi düşün."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Düşünüyorum. Sürekli düşünüyorum. Yine de geliyorum."
        }
      ],
      "sfx": [
        {
          "at_s": 0,
          "id": "ayak_sesi_ada"
        }
      ]
    },
