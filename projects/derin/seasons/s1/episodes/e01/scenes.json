      "lines": [
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yaprağı gördü. Gördü, Ada. Bileğine baktı.",
          "delivery": "fısıltıyla başlar"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Gördüyse neden almadı?"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Çünkü almasına gerek yok! Seni de alacak! Beni de! Emre'yi de!",
          "delivery": "patlayarak"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Bağırma."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Bağırırım! Burada yarın diye bir şey kalmadı!"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Sen git. Bu benim işim."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Senin işin su ölçmek! Gizem çözmek değil!"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Suyu ölçüyorum, Kerem. Su ılık. Su değişti. Doksan yılda ilk kez.",
          "delivery": "sakin ama kesin"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Sen de değişeceksin. Kapıdan sonra kimse geri gelmiyor."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annem gelmedi. Çünkü kimse onu aramadı."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ben eve gidiyorum. Emre'nin yanına.",
          "delivery": "uzun bir sessizlikten sonra, kırgın"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Git."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yarın uğrarım. Eğer yarın varsa."
        }
      ],
