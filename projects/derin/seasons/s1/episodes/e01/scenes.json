      "lines": [
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Su yan taraftan geliyor. Ne demek istedin, anne?",
          "delivery": "kendi kendine"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kuyunun duvarı. Hep düz sandım."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Biraz daha aşağı. Halat yeter mi?",
          "delivery": "feneri halata bağlayıp kuyuya sarkıtırken"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Bir şey var. Taşta. Çizikler."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Hayır. Çizik değil. Çentik."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Bizim çentiklerimiz gibi. Ama burada. Suyun altında."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Ve en sonuncusu… bir yaprak şekli.",
          "delivery": "nefesi kesilerek"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annemin işareti.",
          "voice_preset": "whisper"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annem buradaydı. Kuyunun içinde.",
          "delivery": "fısıltı ile kararlılık arası"
        }
      ],
