          "scale": 0.9
        }
      ],
      "lines": [
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ver şunu, ben çekeyim. Bugün kollarım hâlâ güçlü. Yarın yarım payla kim bilir."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Makaraya dokunma. Geçen sefer halatı kopardın.",
          "delivery": "makarayı çevirirken"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Halat yaşlıydı. Benim gibi."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Yirmi dört yaşındasın."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Derin'de yirmi dört, yukarıda kırk sekiz eder. Hava yarım ya."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Yukarıda kimse yok."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ben de onu diyorum. İtiraz edecek kimse yok."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Geldi."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Her zamanki gibi. Buz gibi, kara, kayanın kalbinden. Hadi, töreni yap."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Bekle."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ne oldu? Kova mı delik?"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Su… ılık.",
          "delivery": "inanamayarak"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ilık mı? Dalga geçme."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Elini sok."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ben suya el sokmam, ben havacıyım."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kerem. Elini sok.",
          "delivery": "ciddi"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Bu… bu nasıl olur? Kuyular hep soğuktur.",
          "delivery": "şakası tamamen bitmiş"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Doksan yıldır hep soğuk. Çentiklerde yazıyor."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Belki aşağıda bir şey ısındı. Bir boru, bir makine…"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Aşağıda makine yok. Aşağıda sadece kaya var."
        }
      ]
    },
