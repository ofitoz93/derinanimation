      ],
      "lines": [
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Duvarı görebilir miyim? Çentiklerini."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Buyurun."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Doksan yıl. Her gün aynı seviye. Ne güzel bir düzen. Hiçbir şey değişmiyor.",
          "delivery": "duvara bakarak, neredeyse şefkatle"
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Bugün de değişmedi, değil mi Ada?"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Değişmedi."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Bileğin. Bakır. Leyla'nınkine çok benziyor."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Onun bileziği."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Islak."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kuyu suyu, efendim. İşim bu."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Elbette. Suyu iyi tut, Ada. Su, Derin'in hafızasıdır. Hafıza da bazen zehirlidir."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Efendim, isterseniz yukarıya kadar size eşlik edeyim."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Gerek yok, Kerem. Ben yolu bilirim. Herkesten iyi bilirim."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Annen de çok soru sorardı.",
          "delivery": "arkasını dönmeden, alçak sesle"
        }
      ],
      "sfx": [
