      ],
      "lines": [
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Su bugün nasıl, Ada?",
          "delivery": "yumuşak, sinsi bir nezaket"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Her zamanki gibi, Saim Efendi. Soğuk.",
          "delivery": "sakin görünmeye çalışarak"
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Soğuk. Güzel. Derin'de her şey her zamanki gibi kalmalı."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Kerem. Sen de buradasın. Havalandırmalar bu kadar aşağıda mı arızalanıyor?"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ben… makarayı tamir ediyordum. Ada'nın makarasını.",
          "delivery": "kekeleyerek"
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Makarayı. Elbette. Kardeşin nasıl? Emre."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Öksürüyor, efendim."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "İlacı yarın gelecek. Ben söyledim."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Teşekkür ederim, Saim Efendi."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Teşekkür etme. Yarın hepimiz için önemli bir gün. İyi geçmesini istiyoruz, değil mi?",
          "delivery": "tehdidi gülümsemeyle"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Neden indiniz, efendim? Divan Başı on ikinci kata inmez."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "İner, Ada. Gerekirse iner. Annen zamanında çok inerdim."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annemi tanıyordunuz."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Derin'de herkes herkesi tanır. Leyla'yı benden iyi tanıyan azdı."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "O zaman neden kapıdan geçirildi?",
          "delivery": "sesi titrer ama geri adım atmaz"
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Çünkü kuralı çiğnedi."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kazmadı. Sadece sordu."
        },
        {
          "speaker": "saim",
          "type": "dialogue",
          "text": "Bazı sorular kazmaktan derindir.",
          "delivery": "ağır ağır"
        }
      ],
      "sfx": [
