        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Jetonlar. Sırayla. Elinizde tutun.",
          "delivery": "yüksek sesle, sıkılmış"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yaman bugün kendisi gelmiş. Kötü işaret.",
          "voice_preset": "whisper"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Senin için her şey kötü işaret.",
          "voice_preset": "whisper"
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Su bekçisi. Ada, değil mi?"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Evet."
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Jeton."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Burada."
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Bu hafta yarım pay. Divan'ın kararı."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yarım mı? Ama kardeşim…"
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Herkesin bir kardeşi var, tamirci. Rüzgâr kötü."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Rüzgârı hiç gördün mü, Yaman?"
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Görmeme gerek yok. Kayıtlar var."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kayıtları kim yazıyor?"
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Bileğindeki ne?",
          "delivery": "gözleri bileziğe kayar"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annemin bileziği."
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Annenin. Leyla'nın.",
          "delivery": "bir an duraksar, sesi değişir"
        },
        {
          "speaker": "yaman",
          "type": "dialogue",
          "text": "Bileğini sakla, Ada. Burada herkes bir şeyler hatırlar.",
          "delivery": "alçak sesle, neredeyse uyarır gibi"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Gidelim. Lütfen."
        }
      ],
      "sfx": [
        {
          "at_s": 0,
          "id": "kalabalik_ugultu",
          "loop": true
        },
