      "lines": [
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yine mi çentik? Su bugün de aynı yerde, söyleyeyim sana.",
          "delivery": "merdivenden inerken"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Söyleme. Ölç."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ölçtüm. Dün de ölçtüm. Su bekçisinin işi değil mi bu? Benim işim hava."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Senin işin havalandırmaları tamir etmek. Sen ise içlerinde uyuyorsun.",
          "delivery": "çentiği kazırken, başını çevirmeden"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Orası Derin'in en temiz havası. Divan bile bu kadar iyisini solumuyor."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annemin annesi bu duvara çentik attı. Sonra annem. Şimdi ben.",
          "delivery": "duvara dokunarak"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Bir gün de senin kızın. Şanslı kız. Bütün hayatı bir duvar.",
          "delivery": "takılarak"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kızım olmayacak."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Neden?"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Burada büyüsün diye mi?",
          "delivery": "sert"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Emre dün gece yine öksürdü. Sabaha kadar.",
          "delivery": "sesi alçalır"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "İlacı bitti mi?",
          "delivery": "yumuşayarak"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Divan yarın verecekmiş. Yarın diyorlar. Hep yarın."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Saim'e git. Yüzüne söyle."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Saim'in yüzüne bir şey söyleyen kimse görmedim. Sen hariç. Annen hariç."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annem söyledi ve gitti."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ben de onu diyorum."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kural belli. Yukarı kazılmaz. Annem kazmadı, Kerem. Sadece sordu.",
          "delivery": "kararlı"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Burada sormak da kazmak gibi."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "O zaman ben de kazıyorum."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Lütfen bunu bir daha kimsenin yanında söyleme.",
          "delivery": "gerçekten korkmuş"
        }
      ],
