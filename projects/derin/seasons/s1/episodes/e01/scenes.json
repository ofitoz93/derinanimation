    {
      "id": "s08",
      "name": "Nur Ana",
      "duration_s": 8,
      "location": "nur-ana-odasi",
      "light": {
        "type": "lantern",
        "x": 335,
        "y": 300,
        "onFloor": true,
        "lit": true
      },
      "camera_mode": "dialogue",
      "music": {
        "id": "nur_ana_tema",
        "in_s": 2
      },
      "caption": {
        "text": "NUR ANA'NIN ODASI",
        "in_s": 0.8,
        "out_s": 4.5
      },
      "cast": [
        {
          "id": "kerem",
          "view": "side",
          "expression": "sakin",
          "x": 70,
          "y": 150,
          "scale": 0.9
        },
        {
          "id": "ada",
          "view": "side",
          "expression": "sakin",
          "x": 205,
          "y": 152,
          "scale": 0.9,
          "expressionAt": [
            {
              "at_s": 70.5,
              "expression": "saskin"
            }
          ]
        },
        {
          "id": "nur-ana",
          "view": "front",
          "expression": "sakin",
          "x": 400,
          "y": 178,
          "scale": 0.82
        }
      ],
      "lines": [
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Ayak seslerinden tanırım. Ada. Ve kapıda dikilen korkak tamirci.",
          "delivery": "yaşlı, gülümseyen bir ses"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Korkak değil, dikkatli, Nur Ana."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Senin deden de dikkatliydi. Hiçbir şey görmeden öldü."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Sana bir şey getirdim. Elini ver."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Ne bu? Islak… ince… yumuşacık.",
          "delivery": "parmaklarıyla yoklayarak"
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kuyudan çıktı. Rengi yeşil."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Yeşil. Bu kelimeyi bir kez daha duyacağımı sanmazdım.",
          "delivery": "derin bir nefesle"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Ne olduğunu biliyor musun?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Yaprak, evladım. Ağaçta biter. Ağaç da güneşte."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Güneş yok."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Kurucular öyle dedi. Kurucular çok şey dedi."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Sen ne diyorsun?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Ninem yukarıyı görmüştü. Toprak kokardı, derdi. Yağmurdan sonra her yer yeşil olurdu.",
          "delivery": "masal anlatır gibi"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Sonra da Kül Rüzgârı geldi."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Ninem rüzgârı hiç anlatmazdı. Sadece kapıyı anlatırdı. Büyük, demir bir kapı."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Herkes aşağı iner, kapı kapanır. Kapıyı da içeriden kilitlerler."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "İçeriden mi? Neden içeriden?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Ninem 'bir şeyi korumak için' derdi. Neyi diye sorduğumda susardı."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Biz mi korunuyoruz, yoksa biz mi bir şeyi koruyoruz?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Bu soruyu bana daha önce biri daha sordu. Aynı kelimelerle.",
          "delivery": "duraksayarak"
        }
      ],
      "sfx": [
        {
          "at_s": 0,
          "id": "mum_citirti",
          "loop": true
        }
      ]
    },
    {
      "id": "s09",
      "name": "Leyla'nın sorusu",
      "duration_s": 8,
      "location": "nur-ana-odasi",
      "light": {
        "type": "lantern",
        "x": 335,
        "y": 300,
        "onFloor": true,
        "lit": true
      },
      "camera_mode": "dialogue",
      "music": {
        "id": "nur_ana_tema",
        "in_s": 0
      },
      "cast": [
        {
          "id": "kerem",
          "view": "side",
          "expression": "sakin",
          "x": 70,
          "y": 150,
          "scale": 0.9
        },
        {
          "id": "ada",
          "view": "side",
          "expression": "saskin",
          "x": 205,
          "y": 152,
          "scale": 0.9,
          "expressionAt": [
            {
              "at_s": 39.4,
              "expression": "kararli"
            }
          ]
        },
        {
          "id": "nur-ana",
          "view": "front",
          "expression": "sakin",
          "x": 400,
          "y": 178,
          "scale": 0.82
        }
      ],
      "lines": [
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Kim?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Annen."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annem burada mıydı?",
          "delivery": "nefesi kesilir"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Tam senin oturduğun yerde. Elinde de bir yaprak vardı. On yıl önce."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "On yıl önce mi? O zaman bu ilk değil."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Su ne zaman ılırsa, yeşil gelir. Leyla öyle derdi."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Annem ne yaptı?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Suyun nereden geldiğini aradı. Ve buldu sanırım. Çünkü bir hafta sonra kapıdan geçirdiler onu."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Nereden geldiğini söyledi mi?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Bir şey söyledi. Hiç unutmadım."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "'Su yukarıdan inmiyor, Nur Ana. Aşağıdan da gelmiyor. Su yan taraftan geliyor.'",
          "delivery": "Leyla'yı taklit eder gibi, fısıltıyla"
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Yan taraftan mı? Bu ne demek?"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Bilmiyorum, evladım. Ben kör bir kadınım; yanları göremem."
        },
        {
          "speaker": "ada",
          "type": "dialogue",
          "text": "Ben görebilirim.",
          "delivery": "kararlı"
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Görürsün. Annen de görmüştü. Bak nereye götürdü."
        },
        {
          "speaker": "kerem",
          "type": "dialogue",
          "text": "Nur Ana, onu cesaretlendirme. Lütfen."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Ben kimseyi cesaretlendirmem, tamirci. Su yolunu bulur. Bu kız da sudan."
        },
        {
          "speaker": "nur-ana",
          "type": "dialogue",
          "text": "Yaprağı sakla, Ada. Ve suyu izle. Kuyu sana herkesten çok şey anlatır."
        }
      ],
      "sfx": [
        {
          "at_s": 0,
          "id": "mum_citirti",
          "loop": true
        }
      ]
    },
    {
      "id": "s10",
